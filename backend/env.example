# Copy to ./env and fill in. Do NOT commit env (in .gitignore).
ADMIN_TOKEN=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=chucklericain@gmail.com
CORS_ORIGIN=https://pariscomedy.com
# DB_PATH=/Users/chuck/.../data/paris.db  # default is ../data/paris.db

# --- Email provider (BACKEND.EMAIL.2-DNS-PROVIDER) ---
# Default: EMAIL_SEND_REAL=false (dry-run). Set to true ONLY after DNS is verified.
EMAIL_PROVIDER=postmark
EMAIL_SEND_REAL=false
EMAIL_FROM=noreply@pariscomedy.com
EMAIL_REPLY_TO=support@pariscomedy.com
POSTMARK_SERVER_TOKEN=PLACEHOLDER_DO_NOT_COMMIT
POSTMARK_MESSAGE_STREAM=outbound
SUPPORT_EMAIL=support@pariscomedy.com
PAYMENTS_EMAIL=payments@pariscomedy.com

# --- Auth V2 (disabled in production until staging cutover completes) ---
AUTH_V2_ENABLED=false
AUTH_V2_DRY_RUN_MAILER=true

# --- Backend features (all scaffold-only; keep false until ChatGPT approves cutover) ---
SUBMISSIONS_V2_ENABLED=false
CLAIMS_V2_ENABLED=false
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=dryrun
PAYMENT_WEBHOOKS_ENABLED=false
MESSAGING_V2_ENABLED=false
TICKETS_ADAPTERS_ENABLED=false
TICKET_IMPORTS_ENABLED=false
AFFILIATE_LINKS_ENABLED=false
