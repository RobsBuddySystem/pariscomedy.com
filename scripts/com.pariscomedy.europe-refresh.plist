<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.pariscomedy.europe-refresh.plist — DESIGN ONLY, NOT LOADED.

  Nightly refresh of the Europe hub's static per-event pages. Intended
  launchd schedule: 03:25 local, after the upstream JSON export lands.

  IMPORTANT — data provenance: data/upcoming_events.json is NOT produced by
  this job. It is exported from the comedy-network-db project (Postgres) and
  synced into this repo ahead of the 03:25 run. This plist only regenerates
  the static HTML/JSON *derived from* that file — scripts/build_europe_pages.py
  reads data/upcoming_events.json as-is and writes europe/<city>/<event>.html
  plus data/ticket_links.json. If the export step is not wired up before
  this job is loaded, it will silently rebuild pages from stale data.

  To actually enable this job (NOT done as part of this build task):
    cp scripts/com.pariscomedy.europe-refresh.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.pariscomedy.europe-refresh.plist

  Per project standing rule (validate-before-cron): run build_europe_pages.py
  manually at least once and have Robert review output before this loads.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pariscomedy.europe-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/chuck/pariscomedy-push-20260526-095907/scripts/build_europe_pages.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/chuck/pariscomedy-push-20260526-095907</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>25</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/chuck/pariscomedy-push-20260526-095907/logs/europe-refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/chuck/pariscomedy-push-20260526-095907/logs/europe-refresh.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
