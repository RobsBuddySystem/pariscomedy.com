# ParisComedy daily pipeline — openclawpc (RTX 3090)
#
# Install: crontab pipeline/automation/openclawpc.crontab
# Check:   crontab -l
#
# Adjust REPO path to wherever the repo lives on openclawpc.
# Times are in LOCAL system time. If openclawpc runs UTC, adjust:
#   06:00 Paris (CET/UTC+1) = 05:00 UTC
#   06:00 Paris (CEST/UTC+2) = 04:00 UTC
# Use TZ= prefix to be explicit:

REPO=/home/chuck/pariscomedy.com/_repo
LOGDIR=/var/log/pariscomedy

# Daily pipeline at 06:00 Paris time (CEST = UTC+2 in summer)
# Ollama must be running: systemctl status ollama
TZ=Europe/Paris
0 6 * * * cd $REPO && ./pipeline/run_pipeline.sh >> $LOGDIR/pipeline.log 2>&1

# Sync to Mac Studio at 06:35 (after pipeline completes)
TZ=Europe/Paris
35 6 * * * cd $REPO && ./pipeline/sync/sync_to_macstudio.sh >> $LOGDIR/sync.log 2>&1

# Weekly: prune pipeline logs older than 30 days
0 4 * * 0 find $REPO/pipeline/logs -name "pipeline_*.log" -mtime +30 -delete

# Weekly: prune daily metrics older than 90 days
5 4 * * 0 find $REPO/pipeline/output -name "metrics_*.json" -mtime +90 -delete
